# Anyrouter Keepalive - Configuration
# Copy this file to .env and fill in your values

# Required: Your Anyrouter API tokens (one per line)
ANYROUTER_TOKENS="sk-ant-xxx111
sk-ant-xxx222
sk-ant-xxx333"

# Optional: QQ email for report notifications (leave empty to skip email)
QQ_EMAIL="yourname@qq.com"

# Optional: QQ SMTP authorization code (not your QQ password!)
# Generate from QQ Mail -> Settings -> Account -> POP3/IMAP/SMTP service
QQ_SMTP_AUTH_CODE="your_smtp_auth_code"

# Optional overrides
# BASE_URL="https://anyrouter.top"
# MODEL="claude-opus-4-8[1m]"

# Protocol: auto (default) | anthropic | responses | openai
#   auto: 模型 id 以 claude 开头走 Anthropic 协议（Claude Code CLI），
#         其他 id（如 gpt-6-astra）走 OpenAI Responses（/v1/responses）
# PROTOCOL="auto"

# Model id examples
# MODEL="claude-opus-4-8[1m]"   # Anthropic 协议
# MODEL="gpt-6-astra"           # OpenAI 协议（自动判断）

# 仅 OpenAI 协议使用：默认 128，设为 none 则不发送 token 上限字段
# MAX_TOKENS="128"

# 两次请求之间的间隔秒数（留空 = 旧默认节奏：token 间 30s 抖动，轮间 50/30 分钟）
# 设为 N 时严格间隔 N 秒，同一轮内、轮与轮之间都生效
# REQUEST_INTERVAL_SEC="30"

# Prompt 池文件（默认 scripts/prompts.txt，20 条轻量探针）
# 换回工程提问池：PROMPTS_FILE="scripts/prompts-engineering.txt"
# PROMPTS_FILE="scripts/prompts.txt"
